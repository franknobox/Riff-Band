{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai4ms.local/schemas/research_protocol.schema.json",
  "title": "AI4MS Research Protocol",
  "type": "object",
  "required": ["protocol_version", "project", "question", "design", "data_contracts", "analysis_plan", "gates"],
  "properties": {
    "protocol_version": {"type": "string", "const": "0.1.0"},
    "project": {
      "type": "object",
      "required": ["project_id", "title", "owner", "status"],
      "properties": {
        "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
        "title": {"type": "string", "minLength": 3},
        "owner": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft", "active", "paused", "frozen", "archived"]},
        "created_at": {"type": "string", "format": "date-time"},
        "target_outlet": {"type": "string"},
        "non_goals": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": ["phenomenon", "question_text", "goal", "unit_of_analysis", "time_scope", "geography", "falsification"],
      "properties": {
        "phenomenon": {"type": "string"},
        "question_text": {"type": "string", "minLength": 10},
        "goal": {"enum": ["describe", "explain", "causal", "predict", "optimize", "design", "synthesize", "theory_build"]},
        "unit_of_analysis": {"type": "string"},
        "time_scope": {"type": "string"},
        "geography": {"type": "string"},
        "theory_anchors": {"type": "array", "items": {"type": "string"}},
        "expected_contribution": {"type": "string"},
        "falsification": {"type": "string", "minLength": 5}
      },
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "required": ["lane", "primary_method_id", "alternatives_considered", "decision_rationale", "human_approved"],
      "properties": {
        "lane": {"enum": ["empirical_causal", "analytical_optimization", "predictive_computational", "behavioral_qualitative", "synthesis_design_science"]},
        "primary_method_id": {"type": "string", "pattern": "^M[0-9]{2}$"},
        "secondary_method_ids": {"type": "array", "items": {"type": "string", "pattern": "^M[0-9]{2}$"}},
        "alternatives_considered": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "decision_rationale": {"type": "string", "minLength": 20},
        "identification_or_optimality_target": {"type": "string"},
        "human_approved": {"type": "boolean", "const": true},
        "approved_by": {"type": "string"},
        "approved_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assumption_id", "category", "statement", "testability", "status"],
        "properties": {
          "assumption_id": {"type": "string"},
          "category": {"enum": ["identification", "measurement", "behavioral", "mathematical", "data", "deployment"]},
          "statement": {"type": "string"},
          "testability": {"enum": ["testable", "partially_testable", "untestable"]},
          "planned_check": {"type": "string"},
          "status": {"enum": ["open", "supported", "violated", "waived"]},
          "waiver_reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "data_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dataContract"}
    },
    "analysis_plan": {
      "type": "object",
      "required": ["primary_outcome_or_objective", "primary_specification", "diagnostics", "robustness", "stopping_rule"],
      "properties": {
        "estimand": {"type": "string"},
        "primary_outcome_or_objective": {"type": "string"},
        "primary_specification": {"type": "string"},
        "formula_ids": {"type": "array", "items": {"type": "string"}},
        "baseline": {"type": "string"},
        "split_strategy": {"type": "string"},
        "diagnostics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "robustness": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "heterogeneity_or_sensitivity": {"type": "array", "items": {"type": "string"}},
        "stopping_rule": {"type": "string"},
        "preregistered_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["gate_id", "name", "required_checks", "approval_mode"],
        "properties": {
          "gate_id": {"type": "string"},
          "name": {"type": "string"},
          "required_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "approval_mode": {"enum": ["deterministic", "human", "deterministic_and_human"]},
          "status": {"enum": ["pending", "passed", "failed", "waived"]},
          "evidence_artifact_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "dataContract": {
      "type": "object",
      "required": ["data_id", "source_id", "access_status", "license_status", "unit_of_observation", "time_coverage", "version_or_snapshot", "pii_class", "quality_checks"],
      "properties": {
        "data_id": {"type": "string"},
        "source_id": {"type": "string"},
        "source_url": {"type": "string", "format": "uri"},
        "access_status": {"enum": ["available", "requested", "blocked", "synthetic"]},
        "license_status": {"enum": ["cleared", "restricted", "pending", "not_applicable"]},
        "unit_of_observation": {"type": "string"},
        "time_coverage": {"type": "string"},
        "version_or_snapshot": {"type": "string"},
        "pii_class": {"enum": ["none", "low", "sensitive", "restricted"]},
        "variables": {"type": "array", "items": {"type": "string"}},
        "join_keys": {"type": "array", "items": {"type": "string"}},
        "quality_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "storage_policy": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
