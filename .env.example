# AI4MS 科研工作台
AI4MS_HOST=0.0.0.0
AI4MS_PORT=8000
AI4MS_DATA_DIR=workspace/ai4ms
# AI4MS_CORS_ORIGINS=http://localhost:8000
AI4MS_MODEL=deepseek-v4-pro
AI4MS_FALLBACK_MODELS=deepseek-v4-flash
AI4MS_INFERENCE_TIMEOUT_SECONDS=90
AI4MS_INFERENCE_MAX_ATTEMPTS=2
AI4MS_INFERENCE_MAX_TOKENS=4000

# S0-S1、S7-S8 AOrchestra 动态 SubAgent 编排
AI4MS_AO_MAX_ATTEMPTS=2
AI4MS_AO_MAX_SUBAGENT_STEPS=7
AI4MS_AO_MAX_PARALLEL=3
AI4MS_AO_TIMEOUT_SECONDS=150

# Optional Stata BYOL runner. Never place license keys in this file.
# Docker 工作台通过 host.docker.internal 连接研究者本机 Local Runner。
AI4MS_STATA_RUNNER_URL=http://host.docker.internal:8765
AI4MS_STATA_RUNNER_TOKEN=replace-with-a-long-random-token
AI4MS_MAX_DATA_UPLOAD_BYTES=1073741824

# 以下变量由研究者本机的 ai4ms-stata-runner 读取。
AI4MS_STATA_EXECUTABLE=
AI4MS_STATA_VERSION=unknown
AI4MS_STATA_LOCALE=unknown
AI4MS_STATA_LICENSE_MODE=user_byol
AI4MS_STATA_LICENSE_CONFIRMED=false
AI4MS_STATA_MAX_CONCURRENCY=1
AI4MS_ANALYSIS_MAX_CONCURRENCY=1
AI4MS_LOCAL_RUNNER_HOST=0.0.0.0
AI4MS_LOCAL_RUNNER_PORT=8765
AI4MS_LOCAL_RUNNER_DATA_DIR=
AI4MS_LOCAL_RUNNER_MAX_BUNDLE_BYTES=2147483648

# Agent Runtime 与模型配置
# Copy to .env and fill in your keys.

# ── LLM API ──────────────────────────────────────────
# 使用 AUTOENV_OPENAI_* 前缀（OpenAI 兼容 API）
# 多模型用逗号分隔
AUTOENV_OPENAI_API_KEY=your_deepseek_api_key_here
AUTOENV_OPENAI_BASE_URL=https://api.deepseek.com
AUTOENV_OPENAI_MODELS=deepseek-v4-pro,deepseek-v4-flash
AUTOENV_OPENAI_TEMPERATURE=1
AUTOENV_OPENAI_TOP_P=1

# 如需为不同模型配置不同 base_url，用模型专属变量：
# AUTOENV_<MODEL_NAME_UPPER>_API_KEY=...
# 例如: AUTOENV_MINIMAX-M2_7_API_KEY=sk-xxx

# ── 联网搜索 ─────────────────────────────────────────
# Serper API (Google Search)，免费额度 2500 次/月
# https://serper.dev
SERPER_API_KEY=your_serper_api_key_here
SERPER_BASE_URL=https://google.serper.dev/search

# ── HTTP 代理 (可选) ──────────────────────────────────
# WEB_SEARCH_HTTP_PROXY=http://127.0.0.1:7890
# WEB_SEARCH_HTTPS_PROXY=http://127.0.0.1:7890

# ════════════════════════════════════════════════════════
# 以下为 Benchmark 评测工具，日常应用不需要
# ════════════════════════════════════════════════════════

# Jina API — GAIA benchmark 网页内容抓取
# JINA_API_KEY=your_jina_api_key_here

# E2B API — TerminalBench 云端 Linux 沙箱
# E2B_API_KEY=your_e2b_api_key_here
# E2B_SANDBOX_TIMEOUT=3600

# Daytona API — TerminalBench 备选沙箱
# DAYTONA_API_KEY=your_daytona_api_key_here
# DAYTONA_API_URL=
# DAYTONA_TARGET=
